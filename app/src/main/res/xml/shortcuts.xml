<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="unrest" android:enabled="true" android:icon="@drawable/ic_sc_unrest"
        android:shortcutShortLabel="@string/sc_unrest_short" android:shortcutLongLabel="@string/sc_unrest_long">
